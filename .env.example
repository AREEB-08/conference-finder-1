# # ---------------------------------------------------------------------------
# # Copy this file to .env.local and fill in the values you need.
# # .env.local is git-ignored. Never commit real credentials.
# #
# # Every variable below is SERVER-ONLY except the ones marked PUBLIC.
# # NEXT_PUBLIC_* values are embedded in the browser bundle and readable by
# # anyone, so no secret may ever use that prefix. (The Supabase URL and anon
# # key are designed to be public — the database is protected by Row Level
# # Security, not by hiding the key.)
# # ---------------------------------------------------------------------------

# # --- Supabase (accounts, Google sign-in, researcher profiles) --------------
# # Create a project at https://supabase.com, then copy both values from
# # Project Settings -> API. See SETUP.md for the full walkthrough, including
# # Google OAuth and the database schema in supabase/schema.sql.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# # --- Google Sheets: choose ONE of the two options below --------------------

# # Option A (simplest): a Google Apps Script web app that returns the sheet as
# # JSON. Deploy the script with access set to "Anyone", then paste its /exec URL.
# # The app appends ?sheet=conferences or ?sheet=journals to select a tab.
# GOOGLE_SHEETS_API_URL=

# # Option B (recommended for private sheets): a service account with read-only
# # access. Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as a Viewer.
# # When these three are set they take priority over Option A.
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# # Keep the surrounding quotes and the literal \n sequences.
# # GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nLINE1\nLINE2\n-----END PRIVATE KEY-----\n"
# GOOGLE_PRIVATE_KEY=

# # Tab names, if yours differ from the defaults.
# GOOGLE_SHEETS_CONFERENCES_TAB=Sheet1
# GOOGLE_SHEETS_JOURNALS_TAB=Sheet2

# # How long to wait for the sheet before giving up, in milliseconds.
# # Raise this if you see "timed out" (Apps Script cold starts can be slow).
# SHEETS_FETCH_TIMEOUT_MS=20000

# # How many seconds to cache sheet data before re-reading. Default 600 (10 min).
# SHEETS_REVALIDATE_SECONDS=600

# # How to read all-numeric dates like 05/09/2026. DMY (default) or MDY.
# SHEET_DATE_ORDER=DMY

# # --- Manual cache refresh (optional) ---------------------------------------
# # Set to any long random string to enable POST /api/revalidate.
# # Leave empty and that endpoint stays disabled.
# REVALIDATE_SECRET=

# # --- AI assistant (entirely optional) --------------------------------------
# # Leave GROQ_API_KEY empty and the assistant does not render at all.
# # Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# # --- PUBLIC (safe to expose; embedded in the browser bundle) ---------------
# # Absolute site URL for canonical links, Open Graph and the sitemap.
# # Leave empty locally and on the first Vercel deploy; set it once you attach
# # a custom domain. No trailing slash.
# NEXT_PUBLIC_SITE_URL=






NEXT_PUBLIC_SUPABASE_URL=https://qzhasbiqomlfahvxbcwl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_A22rNXj7HF1Bnpk-ZLtEUw_0gEs72GA
GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbwsSCgu1U-u29qQEDz71tE4tZNq_pL-I7yCaXTdh3wUfL5JIYLUY9oqF2qRT8HSpG1I/exec

GOOGLE_SHEETS_ID=1RSorERswCwbDGYvCu-ZluO1KvIPSyIKivfPBpPo7xvs

GOOGLE_SHEETS_CONFERENCES_TAB=Sheet1
GOOGLE_SHEETS_JOURNALS_TAB=Sheet2

SHEETS_FETCH_TIMEOUT_MS=20000
SHEETS_REVALIDATE_SECONDS=600

SHEET_DATE_ORDER=DMY

REVALIDATE_SECRET=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

NEXT_PUBLIC_SITE_URL=
